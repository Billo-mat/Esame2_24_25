def check_sampling_date(row):
    try:
        # 1. Proviamo a estrarre la data dal Sample_ID usando la tua funzione
        y, m, d = date_from_sample_id(row['Sample_ID'])
        
        # 2. Creiamo l'oggetto data per il confronto
        # Usiamo pd.Timestamp o datetime.date
        extracted_date = pd.Timestamp(year=y, month=m, day=d)
        
        # 3. Confrontiamo con la colonna 'sampling_date'
        # Restituisce True se sono uguali, False se sono diverse
        return extracted_date == row['sampling_date']
    
    except (ValueError, IndexError):
        # Se l'ID non ha 6 cifre o ha lettere (come 'B0'), la funzione darà errore.
        # In questo caso, il controllo fallisce perché l'ID è malformato.
        return False

# Applichiamo il controllo a tutto il dataframe
